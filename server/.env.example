# Copy to .env (same directory) and fill in real values before any shared
# or public deployment. `.env` is gitignored — never commit real secrets.

# HMAC signing secret for Verified Hiring Channel tokens (server/engine/tokens.js).
# Without this set, the server falls back to a placeholder secret and prints a
# loud warning on startup — anyone reading the source could forge a "verified"
# hiring token against that instance. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCH_TOKEN_SECRET=

# Port the API listens on. Defaults to 4180 if unset.
PORT=4180
