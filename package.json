{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "description": "Vouch — a verified referral bridge and hiring-fraud interception layer for LinkedIn",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "seed": "npm --workspace server run seed",
    "test": "node --test server/engine/engine.test.js server/engine/domain.test.js server/services.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
